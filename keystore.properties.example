# Bu dosyayı `keystore.properties` adıyla kopyalayıp kendi imza bilgilerinizi girin.
# Örnek upload keystore oluşturma komutu:
# keytool -genkey -v -keystore waveform-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias waveform
storeFile=waveform-upload.jks
storePassword=CHANGE_ME
keyAlias=waveform
keyPassword=CHANGE_ME
